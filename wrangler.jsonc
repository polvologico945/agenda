{
  "$schema":"node_modules/wrangler/config-schema.json",
  "name":"agenda-cnh",
  "main":"worker/index.ts",
  "compatibility_date":"2026-10-29",
  "assets":{"directory":"./dist","binding":"ASSETS","not_found_handling":"single-page-application","run_worker_first":["/api/*"]},
  "d1_databases":[{"binding":"DB","database_name":"agenda-cnh-db","database_id":"SUBSTITUA_PELO_ID_DO_D1","migrations_dir":"migrations"}],
  "r2_buckets":[{"binding":"PHOTOS","bucket_name":"agenda-cnh-photos"}],
  "triggers":{"crons":["0 4 * * *"]},
  "vars":{"APP_URL":"http://localhost:8787","ENVIRONMENT":"production"}
}
